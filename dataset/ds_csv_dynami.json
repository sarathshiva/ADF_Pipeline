{
	"name": "ds_csv_dynami",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_datalake",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_container": {
				"type": "string"
			},
			"p_folder": {
				"type": "string"
			},
			"p_files": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"folderPath": "files",
				"fileSystem": "source"
			},
			"columnDelimiter": ",",
			"rowDelimiter": "\n",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "customer_id",
				"type": "String"
			},
			{
				"name": "first_name",
				"type": "String"
			},
			{
				"name": "last_name",
				"type": "String"
			},
			{
				"name": "email",
				"type": "String"
			},
			{
				"name": "phone_number",
				"type": "String"
			},
			{
				"name": "city",
				"type": "String"
			},
			{
				"name": "signup_date",
				"type": "String"
			},
			{
				"name": "last_updated_timestamp",
				"type": "String"
			}
		]
	}
}