						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('Totalresults').output.resultSets[0].rows[0].TOTAL_COUNT,0 )",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "load",
