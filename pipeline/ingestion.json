									{
										"type": "Query",
										"text": {
											"value": "SELECT MAX(last_updated) AS max_cdc\nFROM @{pipeline().parameters.schema}.@{pipeline().parameters.table}\n",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
